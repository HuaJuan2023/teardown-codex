{
  "name": "CERATO / mechanical horned frog",
  "units": "mm",
  "reference": [
    {
      "url": "https://sib.gob.ar/especies/ceratophrys-ornata",
      "supports": "broad head, short body, horned eyelids; not mechanical dimensions"
    },
    {
      "path": "references/biological-envelope.json",
      "supports": "previous biological envelope study"
    }
  ],
  "assumptions": [
    "Original miniature robot concept; no sourced actuator SKU or manufacturing CAD.",
    "Joint commands and root trajectory are prescribed; spring settings do not predict jump height.",
    "Gear profiles are approximate; no tooth-contact dynamics or full-solid interference test.",
    "Ankle and toe posture are coupled teaching outputs.",
    "Spring couplers are telescopic; no latch, preload or force closure certification.",
    "R2 optical gimbal servos and auxiliary fan are original package illustrations, not sourced actuator products.",
    "Walking uses prescribed diagonal contact phases with exact two-link IK; cinematic entry and stop transitions do not solve contact dynamics.",
    "Cover hinges and exploded offsets are display mechanisms; no complete solid swept-volume collision certification."
  ],
